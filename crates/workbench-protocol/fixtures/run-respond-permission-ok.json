{
  "name": "run-respond-permission-ok",
  "seed": {
    "benchDir": true
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-52",
        "input": {
          "workingDirectory": "{{dir}}"
        },
        "idempotencyKey": "k-52"
      },
      "expect": {
        "reply": {
