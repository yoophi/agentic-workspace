        "idempotencyKey": "k-54"
      },
      "expect": {
        "reply": {
          "kind": "complete"
        }
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.respondPermission",
        "requestId": "r-55",
        "input": {
          "benchId": "{{bench}}",
          "runId": "r1",
          "permissionId": "p1",
          "optionId": "allow"
        },
        "idempotencyKey": "k-55"
      },
      "expect": {
        "fault": {
          "code": "notFound",
          "message": "unknown or already answered permission: p1"
        }
      }
