{
  "name": "orchestration-bind-coordinator-foreign-run-forbidden",
  "seed": {
    "gitRepo": {
      "commits": [
        {
          "message": "init",
          "files": {
            "README.md": "hello\n"
          }
        }
      ]
    }
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-26",
        "input": {
          "workingDirectory": "{{repo}}"
        },
        "idempotencyKey": "k-26"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "workingDirectory": "{{repo}}"
          }
        }
      },
      "capture": {
        "bench": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "orchestration.bootstrap",
        "requestId": "r-27",
        "input": {
          "benchId": "{{bench}}",
          "worktreePath": "{{repo}}"
        },
        "idempotencyKey": "k-27"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "worktreePath": "{{repo}}",
            "revision": 0
          }
        }
      },
      "capture": {
        "workspace": "/output/id",
        "stream": "/output/eventStreamId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-28",
        "input": {
          "workingDirectory": "{{repo}}"
        },
        "idempotencyKey": "k-28"
      },
      "expect": {
        "reply": {
          "kind": "complete"
        }
      },
      "capture": {
        "bench2": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.start",
        "requestId": "r-29",
        "input": {
          "benchId": "{{bench2}}",
          "request": {
            "goal": "g",
            "agentId": "codex",
            "runId": "theirs"
          }
        },
        "idempotencyKey": "k-29"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "id": "theirs"
          }
        }
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "orchestration.bindCoordinator",
        "requestId": "r-30",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "requestId": "bind-theirs",
            "panelId": "main-agent-run",
            "runId": "theirs",
            "state": "active",
            "expectedRevision": 0
          }
        },
        "idempotencyKey": "k-30"
      },
      "expect": {
        "fault": {
          "code": "forbidden",
          "message": "run is owned by another bench."
        }
      }
    }
  ],
  "ignoreFields": [
    "createdAt",
    "updatedAt",
    "startedAt",
    "lastActivityAt",
    "completedAt",
    "collectedAt",
    "endedAt",
    "deliveredAt",
    "dispatchedAt",
    "acknowledgedAt"
  ]
}
