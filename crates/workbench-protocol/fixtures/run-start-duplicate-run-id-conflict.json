{
  "name": "run-start-duplicate-run-id-conflict",
  "seed": {
    "benchDir": true
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-7",
        "input": {
          "workingDirectory": "{{dir}}"
        },
        "idempotencyKey": "k-7"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "workingDirectory": "{{dir}}"
          }
        }
      },
      "capture": {
        "bench": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.start",
        "requestId": "r-8",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "goal": "do it",
            "agentId": "codex",
            "runId": "r1"
          }
        },
        "idempotencyKey": "k-8"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "id": "r1",
            "goal": "do it",
            "agentId": "codex"
          }
        }
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.start",
        "requestId": "r-9",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "goal": "do it",
            "agentId": "codex",
            "runId": "r1"
          }
        },
        "idempotencyKey": "k-9"
      },
      "expect": {
        "fault": {
          "code": "conflict",
          "message": "duplicate run id: r1"
        }
      }
    }
  ]
}
