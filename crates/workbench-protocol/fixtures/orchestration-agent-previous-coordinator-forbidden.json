{
  "name": "orchestration-agent-previous-coordinator-forbidden",
  "seed": {
    "gitRepo": {
      "commits": [
        {
          "message": "init",
          "files": {
            "README.md": "hello\n"
          }
        }
      ]
    }
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-1",
        "input": {
          "workingDirectory": "{{repo}}"
        },
        "idempotencyKey": "k-1"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "workingDirectory": "{{repo}}"
          }
        }
      },
      "capture": {
        "bench": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "orchestration.bootstrap",
        "requestId": "r-2",
        "input": {
          "benchId": "{{bench}}",
          "worktreePath": "{{repo}}"
        },
        "idempotencyKey": "k-2"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "worktreePath": "{{repo}}",
            "revision": 0
          }
        }
      },
      "capture": {
        "workspace": "/output/id",
        "stream": "/output/eventStreamId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.start",
        "requestId": "r-3",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "goal": "g",
            "agentId": "codex",
            "runId": "coord"
          }
        },
        "idempotencyKey": "k-3"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "id": "coord"
          }
        }
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "orchestration.bindCoordinator",
        "requestId": "r-4",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "requestId": "bind-coord",
            "panelId": "main-agent-run",
            "runId": "coord",
            "state": "active",
            "expectedRevision": 0
          }
        },
        "idempotencyKey": "k-4"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "id": "{{workspace}}",
            "revision": 1
          }
        }
      },
      "capture": {
        "generation": "/output/activeCoordinatorGenerationId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "orchestration.get",
        "requestId": "r-38",
        "input": {
          "benchId": "{{bench}}"
        }
      },
      "expect": {
        "reply": {
          "kind": "complete"
        }
      },
      "capture": {
        "rev": "/output/revision"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "orchestration.handoffCoordinator",
        "requestId": "r-39",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "requestId": "h1",
            "successorRunId": "coord-2",
            "summary": "next",
            "confirmed": true,
            "expectedRevision": "{{#rev}}"
          }
        },
        "idempotencyKey": "k-39"
      },
      "expect": {
        "reply": {
          "kind": "complete"
        }
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "orchestration.listChildTasks",
        "requestId": "r-40",
        "input": {
          "runId": "coord",
          "arguments": {}
        }
      },
      "expect": {
        "fault": {
          "code": "forbidden",
          "details": {
            "toolError": {
              "code": "forbiddenActor",
              "message": "The authenticated agent role cannot call this tool.",
              "retryable": false
            }
          },
          "message": "The authenticated agent role cannot call this tool."
        }
      },
      "principal": "agent:coord"
    }
  ],
  "ignoreFields": [
    "createdAt",
    "updatedAt",
    "startedAt",
    "lastActivityAt",
    "completedAt",
    "collectedAt",
    "endedAt",
    "deliveredAt",
    "dispatchedAt",
    "acknowledgedAt"
  ]
}
