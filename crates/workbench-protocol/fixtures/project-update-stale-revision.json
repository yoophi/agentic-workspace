{
  "name": "project-update-stale-revision",
  "principal": "desktop",
  "seed": {
    "projects": [
      {
        "id": "project-1",
        "name": "Old",
        "workingDirectory": "/tmp/old",
        "description": null
      }
    ]
  },
  "requests": [
    {
      "protocolVersion": 1,
      "operation": "project.update",
      "requestId": "r-pu-s1",
      "input": {
        "id": "project-1",
        "name": "A",
        "workingDirectory": "/tmp/a"
      },
      "idempotencyKey": "k-pu-s1"
    },
    {
      "protocolVersion": 1,
      "operation": "project.update",
      "requestId": "r-pu-s2",
      "input": {
        "id": "project-1",
        "name": "B",
        "workingDirectory": "/tmp/b"
      },
      "idempotencyKey": "k-pu-s2",
      "expectedRevision": 0
