  ],
  "expects": [
    {
      "reply": {
        "kind": "complete",
        "output": {
          "name": "A"
        },
        "revision": 1
      }
    },
    {
      "fault": {
        "code": "preconditionFailed",
        "outcome": "notApplied",
        "details": {
          "expectedRevision": 0,
          "currentRevision": 1
        }
      }
    }
  ],
  "expectAfter": {
