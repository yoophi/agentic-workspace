{
  "name": "worktree-list-files-dir-depth",
  "principal": "desktop",
  "seed": {
    "gitRepo": {
      "commits": [
        {
          "message": "init",
          "files": {
            "README.md": "hello\n"
          }
        },
        {
          "message": "docs",
          "files": {
            "docs/guide.md": "# guide\n"
          }
        },
        {
          "message": "feat",
          "files": {
            "src/a.rs": "fn a() {}\n"
          }
        }
      ]
    }
  },
  "request": {
    "protocolVersion": 1,
    "operation": "worktree.listFiles",
    "requestId": "r-us2-36",
    "input": {
      "workingDirectory": "{{repo}}",
      "scope": {
        "dir": "src",
        "depth": 1
      }
    }
  },
  "expect": {
    "reply": {
      "kind": "complete",
      "output": [
        {
          "name": "a.rs",
          "path": "{{repo}}/src/a.rs",
          "relativePath": "src/a.rs",
          "isDir": false,
          "size": 10
        }
      ]
    }
  },
  "ignoreFields": [
    "modifiedMs"
  ]
}
