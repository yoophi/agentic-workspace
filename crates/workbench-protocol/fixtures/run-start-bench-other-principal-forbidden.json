{
  "name": "run-start-bench-other-principal-forbidden",
  "seed": {
    "benchDir": true
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-15",
        "input": {
          "workingDirectory": "{{dir}}"
        },
        "idempotencyKey": "k-15"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "workingDirectory": "{{dir}}"
          }
        }
      },
      "capture": {
        "bench": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.start",
        "requestId": "r-16",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "goal": "do it",
            "agentId": "codex",
            "runId": "r1"
          }
        },
        "idempotencyKey": "k-16"
      },
      "expect": {
        "fault": {
          "code": "forbidden",
          "message": "bench belongs to another principal."
        }
      },
      "principal": "desktop2"
    }
  ]
}
