{
  "name": "run-send-prompt-inactive",
  "seed": {
    "benchDir": true
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-24",
        "input": {
          "workingDirectory": "{{dir}}"
        },
        "idempotencyKey": "k-24"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "workingDirectory": "{{dir}}"
          }
        }
      },
      "capture": {
        "bench": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.sendPrompt",
        "requestId": "r-25",
        "input": {
          "benchId": "{{bench}}",
          "runId": "r1",
          "prompt": "hi"
        },
        "idempotencyKey": "k-25"
      },
      "expect": {
        "fault": {
          "code": "notFound",
          "message": "agent run is not active"
        }
      }
    }
  ]
}
