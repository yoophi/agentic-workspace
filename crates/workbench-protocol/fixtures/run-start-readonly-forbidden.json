{
  "name": "run-start-readonly-forbidden",
  "seed": {
    "benchDir": true
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-13",
        "input": {
          "workingDirectory": "{{dir}}"
        },
        "idempotencyKey": "k-13"
      },
      "expect": {
