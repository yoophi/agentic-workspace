{
  "name": "run-respond-permission-non-owner",
  "seed": {
    "benchDir": true
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-56",
        "input": {
          "workingDirectory": "{{dir}}"
        },
        "idempotencyKey": "k-56"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "workingDirectory": "{{dir}}"
          }
        }
      },
      "capture": {
