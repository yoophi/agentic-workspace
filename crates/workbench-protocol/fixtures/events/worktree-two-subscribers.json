{
  "name": "worktree-two-subscribers",
  "setup": [
    {
      "hold": [
        {
          "streamId": "worktree:{{tmp}}",
          "afterSequence": 0
        }
      ]
    }
  ],
  "subscribe": [
    {
      "streamId": "worktree:{{tmp}}/",
      "afterSequence": 0
    }
  ],
  "after": [
    {
      "write": "{{tmp}}/a.txt",
      "content": "a"
    }
  ],
  "expect": {
    "items": [
      {
        "event": {
          "sequence": 1,
          "schema": "worktree.changed.v1",
          "body": {
            "kind": "file"
          }
        }
      }
    ]
  }
}
