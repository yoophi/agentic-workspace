{
  "name": "stream-readonly-can-subscribe-runs",
  "principal": "readonly",
  "setup": [
    {
      "publish": "run:r1",
      "count": 1
    }
  ],
  "subscribe": [
    {
      "streamId": "run:r1",
      "afterSequence": 0
    }
  ],
  "expect": {
    "items": [
      {
        "event": {
          "streamId": "run:r1",
          "sequence": 1,
          "schema": "run.event.v1"
        }
      }
    ]
  }
}
