{
  "name": "stream-duplicate-cursor-invalid",
  "setup": [
    {
      "publish": "run:r1",
      "count": 3
    }
  ],
  "subscribe": [
    {
      "streamId": "run:r1",
      "afterSequence": 0
    },
    {
      "streamId": "run:r1",
      "afterSequence": 2
    }
  ],
  "expect": {
    "fault": {
      "code": "invalidArgument",
      "message": "duplicate stream in subscription: run:r1"
    }
  }
}
