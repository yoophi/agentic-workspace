{
  "name": "exchange-sync-stale-source-run",
  "seed": {
    "benchDir": true
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-7",
        "input": {
          "workingDirectory": "{{dir}}"
        },
        "idempotencyKey": "k-7"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "workingDirectory": "{{dir}}"
          }
        }
      },
      "capture": {
        "bench": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "exchange.syncWorkspace",
        "requestId": "r-8",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "worktreePath": "{{dir}}",
            "revision": 1,
            "focusedPanelId": "main",
            "panels": [
              {
                "panelId": "main",
                "title": "Main",
                "runId": "r1",
                "status": "running"
              },
              {
                "panelId": "extra",
                "title": "Extra",
                "runId": "r2",
                "status": "running"
              }
            ]
          }
        },
        "idempotencyKey": "k-8"
      },
      "expect": {
        "fault": {
          "code": "preconditionFailed",
          "details": {
            "exchangeCode": "staleSourceRun"
          },
          "message": "Panel run is inactive or owned by another window."
        }
      }
    }
  ],
  "ignoreFields": [
    "createdAt",
    "updatedAt"
  ]
}
