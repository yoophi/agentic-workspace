{
  "name": "git-list-remotes-seeded",
  "principal": "desktop",
  "seed": {
    "gitRepo": {
      "commits": [
        {
          "message": "init",
          "files": {
            "README.md": "hello\n"
          }
        },
        {
          "message": "docs",
          "files": {
            "docs/guide.md": "# guide\n"
          }
        },
        {
          "message": "feat",
          "files": {
            "src/a.rs": "fn a() {}\n"
          }
        }
      ],
      "remotes": [
        {
          "name": "origin",
          "url": "https://example.com/r.git"
        }
      ]
    }
  },
  "request": {
    "protocolVersion": 1,
    "operation": "git.listRemotes",
    "requestId": "r-us2-1",
    "input": {
      "workingDirectory": "{{repo}}"
    }
  },
  "expect": {
    "reply": {
      "kind": "complete",
      "output": [
        {
          "name": "origin",
          "fetchUrl": "https://example.com/r.git",
          "pushUrl": "https://example.com/r.git"
        }
      ]
    }
  }
}
