{
  "name": "orchestration-run-replay-own-missing-foreign",
  "seed": {
    "gitRepo": {
      "commits": [
        {
          "message": "init",
          "files": {
            "README.md": "hello\n"
          }
        }
      ]
    }
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-35",
        "input": {
          "workingDirectory": "{{repo}}"
        },
        "idempotencyKey": "k-35"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "workingDirectory": "{{repo}}"
          }
        }
      },
      "capture": {
        "bench": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.start",
        "requestId": "r-36",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "goal": "g",
            "agentId": "codex",
            "runId": "r1"
          }
        },
        "idempotencyKey": "k-36"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "id": "r1"
          }
        }
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.replay",
        "requestId": "r-37",
        "input": {
          "benchId": "{{bench}}",
          "runId": "r1",
          "afterSequence": 0
        }
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "runId": "r1",
            "terminal": false
          }
        }
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.replay",
        "requestId": "r-38",
        "input": {
          "benchId": "{{bench}}",
          "runId": "ghost",
          "afterSequence": 3
        }
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "runId": "ghost",
            "events": [],
            "lastSequence": 0,
            "terminal": false,
            "gapDetected": true
          }
        }
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-39",
        "input": {
          "workingDirectory": "{{repo}}"
        },
        "idempotencyKey": "k-39"
      },
      "expect": {
        "reply": {
          "kind": "complete"
        }
      },
      "capture": {
        "bench2": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.replay",
        "requestId": "r-40",
        "input": {
          "benchId": "{{bench2}}",
          "runId": "r1",
          "afterSequence": 0
        }
      },
      "expect": {
        "fault": {
          "code": "forbidden",
          "message": "run is owned by another bench."
        }
      }
    }
  ],
  "ignoreFields": [
    "createdAt",
    "updatedAt",
    "startedAt",
    "lastActivityAt",
    "completedAt",
    "collectedAt",
    "endedAt",
    "deliveredAt",
    "dispatchedAt",
    "acknowledgedAt"
  ]
}
