{
  "name": "bench-request-title-control-char",
  "seed": {
    "benchDir": true
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-8",
        "input": {
          "workingDirectory": "{{dir}}"
        },
        "idempotencyKey": "k-8"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "workingDirectory": "{{dir}}"
          }
        }
      },
      "capture": {
        "bench": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.start",
        "requestId": "r-1",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "goal": "g",
            "agentId": "codex",
            "runId": "r1"
          }
        },
        "idempotencyKey": "k-1"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "id": "r1"
          }
        }
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.requestTitle",
        "requestId": "r-9",
        "input": {
          "runId": "r1",
          "title": "a\u0007b"
        },
        "idempotencyKey": "k-9"
      },
      "expect": {
        "fault": {
          "code": "invalidArgument",
          "details": {
            "titleCode": "invalidTitle"
          },
          "message": "Window title must not contain control characters."
        }
      },
      "principal": "agent:r1"
    }
  ]
}
