{
  "name": "orchestration-bootstrap-readonly-forbidden",
  "seed": {
    "gitRepo": {
      "commits": [
        {
          "message": "init",
          "files": {
            "README.md": "hello\n"
          }
        }
      ]
    }
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-9",
        "input": {
          "workingDirectory": "{{repo}}"
        },
        "idempotencyKey": "k-9"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "workingDirectory": "{{repo}}"
          }
        }
      },
      "capture": {
        "bench": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "orchestration.bootstrap",
        "requestId": "r-10",
        "input": {
          "benchId": "{{bench}}",
          "worktreePath": "{{repo}}"
        },
        "idempotencyKey": "k-10"
      },
      "expect": {
        "fault": {
          "code": "forbidden"
        }
      },
      "principal": "readonly"
    }
  ],
  "ignoreFields": [
    "createdAt",
    "updatedAt",
    "startedAt",
    "lastActivityAt",
    "completedAt",
    "collectedAt",
    "endedAt",
    "deliveredAt",
    "dispatchedAt",
    "acknowledgedAt"
  ]
}
