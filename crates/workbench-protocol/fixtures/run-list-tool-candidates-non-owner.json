{
  "name": "run-list-tool-candidates-non-owner",
  "seed": {
    "benchDir": true
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-66",
        "input": {
          "workingDirectory": "{{dir}}"
        },
        "idempotencyKey": "k-66"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "workingDirectory": "{{dir}}"
          }
        }
      },
      "capture": {
        "bench": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-1",
        "input": {
          "workingDirectory": "{{dir}}"
        },
        "idempotencyKey": "k-1"
      },
      "expect": {
        "reply": {
          "kind": "complete"
        }
      },
      "capture": {
        "bench2": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.start",
        "requestId": "r-67",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "goal": "do it",
            "agentId": "codex",
            "runId": "r1"
          }
        },
        "idempotencyKey": "k-67"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "id": "r1",
            "goal": "do it",
            "agentId": "codex"
          }
        }
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.listToolCandidates",
        "requestId": "r-68",
        "input": {
          "benchId": "{{bench2}}",
          "query": {
            "runId": "r1",
            "agentId": "codex",
            "workingDirectory": "{{dir}}",
            "sessionMode": "new"
          }
        }
      },
      "expect": {
        "fault": {
          "code": "forbidden",
          "message": "tool command candidates were requested from a non-owner window"
        }
      }
    }
  ]
}
