{
  "name": "run-steer-other-bench-forbidden",
  "seed": {
    "benchDir": true
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-32",
        "input": {
          "workingDirectory": "{{dir}}"
        },
        "idempotencyKey": "k-32"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "workingDirectory": "{{dir}}"
          }
        }
      },
      "capture": {
        "bench": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-1",
        "input": {
          "workingDirectory": "{{dir}}"
        },
        "idempotencyKey": "k-1"
      },
      "expect": {
        "reply": {
          "kind": "complete"
        }
      },
      "capture": {
        "bench2": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.start",
        "requestId": "r-33",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "goal": "do it",
            "agentId": "codex",
            "runId": "r1"
          }
        },
        "idempotencyKey": "k-33"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "id": "r1",
            "goal": "do it",
            "agentId": "codex"
          }
        }
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.steer",
        "requestId": "r-34",
        "input": {
          "benchId": "{{bench2}}",
          "runId": "r1",
          "prompt": "hi"
        },
        "idempotencyKey": "k-34"
      },
      "expect": {
        "fault": {
          "code": "forbidden",
          "message": "run is owned by another bench."
        }
      }
