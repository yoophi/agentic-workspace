{
  "name": "exchange-send-from-run-agent",
  "seed": {
    "benchDir": true
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-1",
        "input": {
          "workingDirectory": "{{dir}}"
        },
        "idempotencyKey": "k-1"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "workingDirectory": "{{dir}}"
          }
        }
      },
      "capture": {
        "bench": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.start",
        "requestId": "r-2",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "goal": "g",
            "agentId": "codex",
            "runId": "r1"
          }
        },
        "idempotencyKey": "k-2"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "id": "r1"
          }
        }
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "run.start",
        "requestId": "r-3",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "goal": "g",
            "agentId": "codex",
            "runId": "r2"
          }
        },
        "idempotencyKey": "k-3"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "id": "r2"
          }
        }
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "exchange.syncWorkspace",
        "requestId": "r-4",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "worktreePath": "{{dir}}",
            "revision": 1,
            "focusedPanelId": "main",
            "panels": [
              {
                "panelId": "main",
                "title": "Main",
                "runId": "r1",
                "status": "running"
              },
              {
                "panelId": "extra",
                "title": "Extra",
                "runId": "r2",
                "status": "running"
              }
            ]
          }
        },
        "idempotencyKey": "k-4"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "revision": 1,
            "acceptedPanels": 2
          }
        }
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "exchange.sendFromRun",
        "requestId": "r-32",
        "input": {
          "runId": "r1",
          "request": {
            "requestId": "q1",
            "sourcePanelId": "",
            "sourceRunId": "r1",
            "targetPanelId": "extra",
            "targetRunId": "r2",
            "message": "hello",
            "delivery": "send"
          }
        },
        "idempotencyKey": "k-32"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "requestId": "q1",
            "source": {
              "panelId": "main",
              "runId": "r1"
            },
            "status": "accepted"
          }
        }
      },
      "principal": "agent:r1"
    }
  ],
  "ignoreFields": [
    "createdAt",
    "updatedAt"
  ]
}
