{
  "name": "exchange-send-unregistered",
  "seed": {
    "benchDir": true
  },
  "steps": [
    {
      "request": {
        "protocolVersion": 1,
        "operation": "bench.open",
        "requestId": "r-17",
        "input": {
          "workingDirectory": "{{dir}}"
        },
        "idempotencyKey": "k-17"
      },
      "expect": {
        "reply": {
          "kind": "complete",
          "output": {
            "workingDirectory": "{{dir}}"
          }
        }
      },
      "capture": {
        "bench": "/output/benchId"
      }
    },
    {
      "request": {
        "protocolVersion": 1,
        "operation": "exchange.send",
        "requestId": "r-18",
        "input": {
          "benchId": "{{bench}}",
          "request": {
            "requestId": "q1",
            "sourcePanelId": "main",
            "sourceRunId": "r1",
            "targetPanelId": "extra",
            "targetRunId": "r2",
            "message": "hello",
            "delivery": "send"
          }
        },
        "idempotencyKey": "k-18"
      },
      "expect": {
        "fault": {
          "code": "notFound",
          "details": {
            "exchangeCode": "unknownWorkspace"
          },
          "message": "Agent workspace is not registered."
        }
      }
    }
  ],
  "ignoreFields": [
    "createdAt",
    "updatedAt"
  ]
}
