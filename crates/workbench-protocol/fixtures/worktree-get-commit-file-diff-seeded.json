{
  "name": "worktree-get-commit-file-diff-seeded",
  "principal": "desktop",
  "seed": {
    "gitRepo": {
      "commits": [
        {
          "message": "init",
          "files": {
            "README.md": "hello\n"
          }
        },
        {
          "message": "docs",
          "files": {
            "docs/guide.md": "# guide\n"
          }
        },
        {
          "message": "feat",
          "files": {
            "src/a.rs": "fn a() {}\n"
          }
        }
      ]
    }
  },
  "request": {
    "protocolVersion": 1,
    "operation": "worktree.getCommitFileDiff",
    "requestId": "r-us2-55",
    "input": {
      "workingDirectory": "{{repo}}",
      "commitHash": "{{commit:2}}",
      "path": "src/a.rs"
    }
  },
  "expect": {
    "reply": {
      "kind": "complete",
      "output": {
        "commitHash": "{{commit:2}}",
        "path": "src/a.rs",
        "isBinary": false,
        "isTruncated": false
      }
    }
  }
}
